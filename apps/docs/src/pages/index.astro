---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Stage from "../components/Stage.astro";
import GroupDock from "../components/GroupDock.astro";
import MorphPreview from "../components/MorphPreview.astro";
import IndicatorExample from "../components/IndicatorExample.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import Hint from "../components/Hint.astro";

const REPO = "https://github.com/mikhailmogilnikov/liquid-web";
---

<Base
  title="Liquid Web — fluid interfaces for the web"
  description="Small, framework-agnostic libraries for fluid interfaces: a glass material, a control that becomes a panel, and a highlight that follows the pointer."
>
  <Nav current="home" />

  <main>
    <section class="hero">
      <div class="mark mark--hero"><span class="lb"></span></div>
      <p class="lead rise" style="--i: 1">
        <b>Liquid Web</b> is a family of libraries for fluid interfaces: a glass material in plain CSS,
        controls that grow into panels of it, and highlights that follow the pointer. No framework needed.
      </p>
      <div class="actions rise" style="--i: 2">
        <a class="button button--ink breathe" href="/blur">Get started</a>
        <a class="button button--wash" href={REPO}><Icon name="github" size={18} />GitHub</a>
      </div>
    </section>

    <section class="block showcase" aria-label="Demos and libraries">
      <div class="reveal">
        <Stage />
      </div>

      <div class="libs">
        <article class="lib reveal">
          <div class="lib__scene" data-hints>
            <div class="bd bd-aurora"></div>
            <GroupDock />
            <Hint text="try to drag" light style="top: calc(50% + 34px); left: calc(50% - 31px)" />
          </div>
          <div class="lib__body">
            <a class="lib__head" href="/blur">
              <b>Liquid Blur</b><code>@liquid-web/blur</code><Icon name="arrow" size={16} />
            </a>
            <p>A glass material in plain CSS. Press behaviors, and pieces of glass that melt together.</p>
          </div>
        </article>

        <article class="lib reveal" style="--d: 80ms">
          <MorphPreview>
            <Hint text="tap to switch" light style="top: calc(50% + 30px); left: 50%" />
          </MorphPreview>
          <div class="lib__body">
            <a class="lib__head" href="/morph">
              <b>Morph</b><code>@liquid-web/morph</code><Icon name="arrow" size={16} />
            </a>
            <p>One element flows into another and back, on springs you can turn around mid-way.</p>
          </div>
        </article>

        <article class="lib reveal" style="--d: 160ms">
          <IndicatorExample kind="menu" card />
          <div class="lib__body">
            <a class="lib__head" href="/indicator">
              <b>Indicator</b><code>@liquid-web/indicator</code><Icon name="arrow" size={16} />
            </a>
            <p>One element flies onto whatever is hovered, pressed or chosen: menus, tabs, segmented controls.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="end">
      <div class="mark mark--hero mark--on-reveal" style="--s: 3"><span class="lb"></span></div>
      <p class="lead reveal"><b>Make your interface fluid.</b> Free and open source, MIT.</p>
      <div class="actions reveal">
        <a class="button button--ink breathe" href="/blur">Read the docs</a>
        <a class="button button--wash" href={REPO}><Icon name="github" size={18} />GitHub</a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
