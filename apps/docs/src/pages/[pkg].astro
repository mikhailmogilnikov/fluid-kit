---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Fence from "../components/docs/Fence.astro";
import Icon from "../components/Icon.astro";
import Playground from "../components/Playground.astro";
import MorphDemo from "../components/MorphDemo.astro";
import IndicatorExample from "../components/IndicatorExample.astro";
import DragExample from "../components/DragExample.astro";
import LiftExample from "../components/LiftExample.astro";
import EdgeExample from "../components/EdgeExample.astro";
import TextExample from "../components/TextExample.astro";
import Hint from "../components/Hint.astro";
import FrameworkSwitch from "../components/docs/FrameworkSwitch.astro";

/** A package's documentation, from `src/content/docs/<package>.mdx` */
export async function getStaticPaths() {
  const pages = await getCollection("docs");
  return pages.map((page) => ({ params: { pkg: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);

/** A package's own demo, under its opening: core, all code, has none */
const demo = page.id !== "core";

/** Its first case in the playground, where there is one */
const play = (
  { blur: "blur-dock", edge: "blur-edge", morph: "morph-corner", indicator: "indicator-menu", drag: "drag-snap", lift: "lift-below", text: "indicator-grow" } as Record<string, string>
)[page.id];

/** The contents, from the page's own sections */
const toc = [...(page.body ?? "").matchAll(/<Section\s([^>]*)>/g)].map(([, attrs]) => {
  const attr = (name: string) => new RegExp(`\\b${name}="([^"]*)"`).exec(attrs)?.[1];
  // A section for one framework: its link shows with it, as the section does
  return [attr("id")!, attr("title")!, attr("only")] as const;
});
---

<Base title={`${page.data.name} — Fluid Kit`} description={page.data.description} frameworks={page.data.frameworks}>
  <Nav current={page.id} />

  <main>
    <section class="docs-head">
      <!-- Only the name rises: an animated ancestor would keep the mark's glass from blurring -->
      <h1 class="docs-head__title">
        <span class="mark mark--hero"><span class="lb"></span></span>
        <span class="rise">{page.data.name}</span>
      </h1>
      <p class="docs-head__lead rise" style="--i: 1" set:html={page.data.intro} />
      <div class="rise" style="--i: 1"><FrameworkSwitch /></div>
    </section>

    {
      demo && (
        <section class="docs-demo rise" style="--i: 2" aria-label="Demo">
          {page.id === "blur" && <Playground />}
          {page.id === "morph" && <MorphDemo />}
          {page.id === "indicator" && (
            <IndicatorExample kind="menu" card />
          )}
          {page.id === "drag" && (
            <DragExample kind="pip" card>
              <Hint text="throw it" light style="top: 124px; left: 96px" />
            </DragExample>
          )}
          {page.id === "lift" && (
            <LiftExample kind="photos" card>
              <Hint text="hold it" light style="bottom: 30px; left: 50%" />
            </LiftExample>
          )}
          {page.id === "edge" && (
            <EdgeExample card>
              <Hint text="scroll it" light style="bottom: 30px; left: 50%" />
            </EdgeExample>
          )}
          {page.id === "text" && (
            <TextExample kind="tabs" card>
              <Hint text="tap them" light style="top: calc(50% + 70px); left: 50%" />
            </TextExample>
          )}
        </section>
      )
    }

    <div class="docs">
      <aside class="toc" aria-label="On this page" data-toc>
        <span class="toc__title">On this page</span>
        <span class="toc__mark" aria-hidden="true" data-toc-mark></span>
        {
          toc.map(([id, label, only]) => (
            <a href={`#${id}`} data-only={only}>
              {label}
            </a>
          ))
        }
      </aside>

      <!-- Narrower screens: the same contents, folded, under the nav -->
      <details class="toc-fold lb" data-toc-fold>
        <summary>
          <span class="toc-fold__label">On this page</span>
          <span class="toc-fold__current" data-toc-current></span>
          <Icon name="plus" size={18} />
        </summary>
        <nav aria-label="On this page">
          {
            toc.map(([id, label, only]) => (
              <a href={`#${id}`} data-only={only}>
                {label}
              </a>
            ))
          }
        </nav>
      </details>

      <div class="docs__body">
        <Content components={{ pre: Fence }} />
        {
          play && (
            <a class="docs-play" href={`/playground#${play}`}>
              <span>
                <b>Playground</b>
                Its hard cases, live: slowed down, on other backdrops, with their boxes drawn.
              </span>
              <Icon name="forward" size={18} />
            </a>
          )
        }
      </div>
    </div>
  </main>

  <Footer />
</Base>
