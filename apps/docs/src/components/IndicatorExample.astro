---
import Icon from "./Icon.astro";

/**
 * One of Indicator's examples, live:
 *   - menu: a glass menu whose highlight follows the pointer, across a separator, past a disabled item
 *   - tabs: a tab bar whose pill rests on the chosen tab, dragged across by a press, leaning toward it
 */
interface Props {
  kind: "menu" | "tabs";
  /** As a library's card on the landing: the card's size and corners, and room for a hint (the slot) */
  card?: boolean;
}

const { kind, card = false } = Astro.props;
const tabs = [
  ["play", "Listen"],
  ["search", "Search"],
  ["heart", "Loved"],
  ["layers", "Library"],
] as const;
---

<div
  class:list={["ix", `ix--${kind}`, { "ix--card": card }]}
  data-ix={kind}
  data-hints={card ? "" : undefined}
>
  <div class="bd bd-aurora"></div>

  {
    kind === "menu" && (
      <div class="ix__menu lb" role="menu" aria-label="Album" data-ix-container>
        <span class="ix__highlight" aria-hidden="true" data-ix-indicator />
        <button type="button" role="menuitem">
          <Icon name="plus" size={18} />
          Add to Library
        </button>
        <button type="button" role="menuitem">
          <Icon name="heart" size={18} />
          Love
        </button>
        <button type="button" role="menuitem">
          <Icon name="arrow" size={18} />
          Share Album
        </button>
        <hr />
        <button type="button" role="menuitem">
          <Icon name="copy" size={18} />
          Copy Link
        </button>
        <button type="button" role="menuitem" aria-disabled="true">
          <Icon name="eye" size={18} />
          Show in Store
        </button>
      </div>
    )
  }

  {
    kind === "tabs" && (
      <div class="ix__tabs lb" role="group" aria-label="Library" data-ix-container>
        <span class="ix__pill" aria-hidden="true" data-ix-indicator />
        {tabs.map(([icon, label], i) => (
          <button type="button" aria-pressed={i === 0 ? "true" : "false"}>
            <Icon name={icon} size={22} />
            {label}
          </button>
        ))}
      </div>
    )
  }
  <slot />
</div>

<style>
  .ix {
    position: relative;
    height: 340px;
    display: grid;
    place-items: center;
    border-radius: 20px;
    background: var(--wash);
    isolation: isolate;
  }
  .ix--tabs { height: 220px; }
  .ix--card {
    height: var(--mdemo-height);
    border-radius: var(--radius);
  }

  /* The container is positioned, and a stacking context of its own (glass is), so the indicator at
     z-index -1 is drawn over its surface and under its items */
  .ix__menu {
    position: relative;
    width: 248px;
    display: grid;
    padding: 8px;
    border-radius: 32px;
    color: var(--ink);
    /* A finger drags across the items without scrolling the page */
    touch-action: none;
  }
  .ix__menu button {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 18px 0 16px;
    border-radius: 999px;
    background: none;
    color: inherit;
    font-size: 15px;
    text-align: left;
  }
  .ix__menu button[aria-disabled="true"] { opacity: 0.4; cursor: default; }
  .ix__menu button:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
  .ix__menu hr {
    width: calc(100% - 24px);
    margin: 4px 12px;
    border: 0;
    border-top: 1px solid rgb(127 127 127 / 0.25);
  }
  .ix__highlight {
    position: absolute;
    z-index: -1;
    background: color-mix(in srgb, currentColor 13%, transparent);
  }

  .ix__tabs {
    position: relative;
    display: flex;
    padding: 4px;
    border-radius: 999px;
    color: var(--ink);
    touch-action: none;
  }
  .ix__tabs button {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 2px;
    width: 72px;
    height: 56px;
    border-radius: 999px;
    background: none;
    color: var(--ink-2);
    font-size: 11px;
    font-weight: 500;
    transition: color 0.2s;
  }
  .ix__tabs button[aria-pressed="true"] { color: var(--ink); }
  .ix__tabs button:focus-visible { outline: 2px solid currentColor; outline-offset: -2px; }
  .ix__pill {
    position: absolute;
    z-index: -1;
    background: color-mix(in srgb, currentColor 12%, transparent);
  }
</style>

<script>
  import { createIndicator } from "@liquid-web/indicator";

  for (const scene of document.querySelectorAll<HTMLElement>("[data-ix]:not([data-ix-ready])")) {
    scene.dataset.ixReady = "";
    const container = scene.querySelector<HTMLElement>("[data-ix-container]")!;
    const indicator = scene.querySelector<HTMLElement>("[data-ix-indicator]")!;

    if (scene.dataset.ix === "menu") {
      // Hover for a mouse, a press dragged across for a finger: the defaults
      createIndicator({ container, indicator });
      continue;
    }

    // Tabs: it rests on the chosen one; pressed and dragged, it follows and leans toward the finger
    const tabs = [...container.querySelectorAll<HTMLButtonElement>("button")];
    const pill = createIndicator({
      container,
      indicator,
      trigger: "press",
      rest: tabs.find((t) => t.getAttribute("aria-pressed") === "true") ?? null,
      pull: 1,
      focus: false,
    });
    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        for (const t of tabs) t.setAttribute("aria-pressed", String(t === tab));
        pill.rest = tab;
      });
    }
  }
</script>
