---
import Case from "./Case.astro";

const places = [
  ["Blue Bottle Coffee", "Café · 2 min"],
  ["Golden Gate Park", "Park · 9 min"],
  ["Tartine Bakery", "Bakery · 11 min"],
  ["SFMOMA", "Museum · 14 min"],
  ["Dolores Park", "Park · 15 min"],
  ["Ferry Building", "Market · 18 min"],
  ["Lands End", "Trail · 24 min"],
  ["Coit Tower", "Landmark · 26 min"],
  ["Mission Chinese", "Restaurant · 28 min"],
  ["Baker Beach", "Beach · 31 min"],
];
---

<Case id="drag-snap">
  <div class="dc-rail">
    <span class="dc-dot"></span><span class="dc-dot"></span><span class="dc-dot"></span>
    <div class="dc-card lb" data-card>Drag me</div>
  </div>
</Case>

<Case id="drag-bounds">
  <div class="dc-frame" data-frame>
    <div class="dc-ball lb" data-ball></div>
  </div>
</Case>

<Case id="drag-switch">
  <div class="dc-settings lb">
    <span>Wi-Fi</span>
    <button type="button" class="dc-switch" role="switch" aria-checked="false" aria-label="Wi-Fi" data-switch>
      <span class="dc-thumb lb" data-thumb></span>
    </button>
  </div>
</Case>

<Case id="drag-sheet">
  <div class="dc-screen" data-area>
    <section class="dc-sheet lb" aria-label="Nearby" data-sheet>
      <span class="dc-grabber" aria-hidden="true"></span>
      <h3 class="dc-title">Nearby</h3>
      <ul class="dc-places lb-edge" data-scroll>
        {
          places.map(([name, meta]) => (
            <li>
              <b>{name}</b>
              <span>{meta}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Case>

<Case id="drag-nested">
  <div class="dc-rail dc-rail--wide">
    <div class="dc-player lb" data-card>
      <b>Now playing</b>
      <div class="dc-slider" data-slider>
        <span class="dc-track"><span class="dc-fill"></span></span>
        <span class="dc-knob lb" data-knob></span>
      </div>
    </div>
  </div>
</Case>

<style>
  /* A rail of three snap points */
  .dc-rail {
    position: relative;
    width: min(360px, calc(100% - 32px));
    height: 120px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 40px;
  }
  .dc-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ink-3); }
  .dc-card {
    position: absolute;
    left: 0;
    top: 10px;
    width: 88px;
    height: 100px;
    border-radius: 24px;
    display: grid;
    place-items: center;
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    cursor: grab;
    touch-action: none;
    -webkit-user-select: none;
    user-select: none;
  }
  .dc-card[data-dragging] { cursor: grabbing; }

  /* A frame to keep a ball in */
  .dc-frame {
    position: relative;
    width: min(360px, calc(100% - 32px));
    height: 260px;
    border-radius: 28px;
    border: 2px dashed color-mix(in srgb, var(--ink) 30%, transparent);
  }
  .dc-ball {
    position: absolute;
    left: 0;
    top: 0;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    cursor: grab;
    touch-action: none;
  }

  .dc-settings {
    width: min(320px, calc(100% - 32px));
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-radius: 24px;
    color: var(--ink);
  }
  /* iOS's switch, as on the drag page */
  .dc-switch {
    position: relative;
    flex: none;
    width: 64px;
    height: 30px;
    border-radius: 999px;
    background: color-mix(in srgb, #34c759 calc(var(--on, 0) * 100%), rgb(120 120 128 / 0.32));
    -webkit-user-select: none;
    user-select: none;
  }
  .dc-thumb {
    --lb-transparency: 0;
    --lb-fill: #fff;
    position: absolute;
    top: 2px;
    left: 2px;
    width: 38px;
    height: 26px;
    transition: scale 0.35s var(--settle), --lb-lens 0.3s var(--glide), --lb-transparency 0.3s var(--glide);
  }
  .dc-switch:active .dc-thumb,
  .dc-thumb[data-dragging] { --lb-lens: 1; --lb-transparency: 1; scale: 1.45 1.5; }

  /* A sheet over a screen, as on the drag page */
  .dc-screen { position: absolute; inset: 0; overflow: clip; }
  .dc-sheet {
    position: absolute;
    top: 12px;
    left: 10px;
    right: 10px;
    height: calc(100% + 160px);
    display: flex;
    flex-direction: column;
    padding: 8px 20px 172px;
    border-radius: 28px;
    color: var(--ink);
    -webkit-user-select: none;
    user-select: none;
  }
  .dc-grabber { display: block; width: 36px; height: 5px; margin: 0 auto 14px; border-radius: 99px; background: currentColor; opacity: 0.25; }
  .dc-title { margin: 0 0 12px; font-size: 20px; font-weight: 650; }
  .dc-places {
    flex: 1;
    min-height: 0;
    margin: 0 -20px;
    padding: 0 20px;
    overflow-y: auto;
    overscroll-behavior: contain;
    list-style: none;
  }
  .dc-places li { display: grid; gap: 2px; padding: 12px 0; border-top: 1px solid rgb(127 127 127 / 0.2); font-size: 15px; }
  .dc-places span { color: var(--ink-2); font-size: 13px; }

  /* A card that moves sideways, a slider on it */
  .dc-rail--wide { height: 160px; padding: 0; }
  .dc-player {
    position: absolute;
    left: 0;
    top: 10px;
    width: 100%;
    height: 140px;
    display: grid;
    align-content: center;
    gap: 18px;
    padding: 0 24px;
    border-radius: 28px;
    color: var(--ink);
    cursor: grab;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
  }
  .dc-slider { --knob: 34px; position: relative; height: 28px; cursor: pointer; touch-action: none; }
  .dc-track {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 6px;
    translate: 0 -50%;
    overflow: clip;
    border-radius: 999px;
    background: rgb(120 120 128 / 0.32);
  }
  .dc-fill { display: block; width: calc(var(--v, 0.4) * 100%); height: 100%; background: #007aff; }
  .dc-knob {
    --lb-transparency: 0;
    --lb-fill: #fff;
    position: absolute;
    top: 3px;
    left: 0;
    width: var(--knob);
    height: 22px;
    transition: scale 0.35s var(--settle), --lb-lens 0.3s var(--glide), --lb-transparency 0.3s var(--glide);
  }
  .dc-knob[data-dragging] { --lb-lens: 1; --lb-transparency: 1; scale: 1.4 1.45; }
</style>
