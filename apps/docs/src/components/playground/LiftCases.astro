---
import Case from "./Case.astro";
import Icon from "../Icon.astro";

const reactions = ["❤️", "👍", "😂", "😮", "😢", "🔥"];
const rows = ["Night Swim", "Golden Hour", "Paper Planes", "Low Tide", "Neon Rain", "Glass Houses", "Static", "Slow Bloom", "Afterglow", "Northern Lines", "Saltwater", "Overpass"];
---

{
  ["lift-below", "lift-above", "lift-edges", "lift-tall", "lift-scrolled"].map((id) => (
    <Case id={id}>
      {id === "lift-below" && (
        <div class="lc-photo lc-photo--top" tabindex="0" role="img" aria-label="Photo" style="--a: #84fab0; --b: #8fd3f4" data-target />
      )}
      {id === "lift-above" && (
        <div class="lc-photo lc-photo--bottom" tabindex="0" role="img" aria-label="Photo" style="--a: #fccb90; --b: #d57eeb" data-target />
      )}
      {id === "lift-edges" && (
        <>
          <div class="lc-photo lc-photo--left" tabindex="0" role="img" aria-label="Left photo" style="--a: #ff9a9e; --b: #fad0c4" data-target />
          <div class="lc-photo lc-photo--right" tabindex="0" role="img" aria-label="Right photo" style="--a: #a18cd1; --b: #fbc2eb" data-target />
        </>
      )}
      {id === "lift-tall" && (
        <div class="lc-photo lc-photo--tall" tabindex="0" role="img" aria-label="Tall photo" style="--a: #e0c3fc; --b: #8ec5fc" data-target />
      )}
      {id === "lift-scrolled" && (
        <div class="lc-list lb" data-scroller>
          {rows.map((r, i) => (
            <div class="lc-row" tabindex="0" data-target>
              <span class="lc-art" style={`--h: ${(i * 47) % 360}`} />
              {r}
            </div>
          ))}
        </div>
      )}
      <div class="lc-menu lb" role="menu" aria-label="Photo" hidden data-menu>
        <span class="lc-highlight" aria-hidden="true" data-highlight />
        <button type="button" role="menuitem" data-item>
          Copy
          <Icon name="copy" size={17} />
        </button>
        <button type="button" role="menuitem" data-item>
          Share
          <Icon name="arrow" size={17} />
        </button>
        <button type="button" role="menuitem" data-item>
          Favorite
          <Icon name="heart" size={17} />
        </button>
        <hr />
        <button type="button" role="menuitem" class="lc-danger" data-item>
          Delete
          <Icon name="plus" size={17} />
        </button>
      </div>
    </Case>
  ))
}

<Case id="lift-message">
  <div class="lc-chat lb">
    <div class="lc-bubble lc-bubble--in" tabindex="0" data-target>Are we still on for Friday?</div>
    <div class="lc-bubble lc-bubble--out" tabindex="0" data-target>Yes! 8pm at the usual place</div>
    <div class="lc-bubble lc-bubble--in" tabindex="0" data-target>Perfect, I'll book a table</div>
  </div>
  <div class="lc-stack" role="menu" aria-label="Message" hidden data-menu>
    <div class="lc-reactions lb" role="group" aria-label="React">
      {reactions.map((r) => <button type="button" role="menuitem" aria-label={`React ${r}`}>{r}</button>)}
    </div>
    <div class="lc-menu lb">
      <span class="lc-highlight" aria-hidden="true" data-highlight></span>
      <button type="button" role="menuitem" data-item>Reply <Icon name="back" size={17} /></button>
      <button type="button" role="menuitem" data-item>Copy <Icon name="copy" size={17} /></button>
      <button type="button" role="menuitem" class="lc-danger" data-item>Delete <Icon name="plus" size={17} /></button>
    </div>
  </div>
</Case>

<style>
  /* Held, it gives a little before it lifts */
  [data-target] {
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;
    transition: scale 0.4s var(--settle);
  }
  [data-target][data-lifting] { scale: 0.96; }

  .lc-photo {
    position: absolute;
    width: 120px;
    height: 120px;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--a), var(--b));
  }
  .lc-photo--top { top: 24px; left: calc(50% - 60px); }
  .lc-photo--bottom { bottom: 24px; left: calc(50% - 60px); }
  .lc-photo--left { top: calc(50% - 60px); left: 16px; }
  .lc-photo--right { top: calc(50% - 60px); right: 16px; }
  .lc-photo--tall { bottom: 24px; left: calc(50% - 80px); width: 160px; height: 300px; }

  .lc-list {
    width: min(320px, calc(100% - 32px));
    height: calc(100% - 48px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 8px;
    border-radius: 28px;
    color: var(--ink);
  }
  .lc-row { display: flex; align-items: center; gap: 12px; padding: 8px; border-radius: 14px; font-size: 15px; }
  .lc-art {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: linear-gradient(135deg, hsl(var(--h) 90% 65%), hsl(calc(var(--h) + 60) 90% 55%));
  }

  .lc-chat {
    width: min(360px, calc(100% - 32px));
    display: grid;
    gap: 10px;
    padding: 16px;
    border-radius: 26px;
  }
  .lc-bubble { position: relative; max-width: 78%; padding: 9px 14px; border-radius: 20px; font-size: 15px; line-height: 1.3; }
  .lc-bubble--in { justify-self: start; background: color-mix(in srgb, var(--ink) 9%, var(--ground)); color: var(--ink); }
  .lc-bubble--out { justify-self: end; background: #0a84ff; color: #fff; }

  /* Hidden until it's lifted beside something: `hidden`, which a display of its own would undo */
  [data-menu][hidden] { display: none; }
  .lc-menu { width: 230px; display: grid; padding: 6px; border-radius: 24px; color: var(--ink); }
  .lc-menu button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 42px;
    padding: 0 14px;
    border-radius: 999px;
    color: inherit;
    font-size: 15px;
  }
  .lc-menu .lc-danger { color: #ff3b30; }
  .lc-menu .lc-danger :global(svg) { rotate: 45deg; }
  .lc-menu hr { width: calc(100% - 24px); margin: 3px 12px; border: 0; border-top: 1px solid rgb(127 127 127 / 0.25); }
  .lc-highlight { position: absolute; z-index: -1; background: color-mix(in srgb, currentColor calc(6% + var(--lb-dark) * 6%), transparent); }

  .lc-stack { display: grid; gap: 8px; width: 270px; }
  .lc-stack .lc-menu { justify-self: start; }
  .lc-reactions { display: flex; justify-content: space-between; padding: 6px; border-radius: 999px; }
  .lc-reactions button { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; font-size: 22px; }
</style>
