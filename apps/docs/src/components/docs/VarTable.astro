---
/** Every public variable, its default and what it moves */
const vars = [
  {
    group: "Material",
    items: [
      ["--lb-transparency", "0.5", "0 is opaque, 1 is clear. Moves fill and blur together. Registered, so it transitions."],
      ["--lb-depth", "0.5", "0 is flat, 1 is pronounced. Moves shading, glow and rims."],
      ["--lb-lens", "0", "0 is glass, 1 is a lens without blur, like lb-lens. Registered, so it transitions."],
      ["--lb-dark", "per theme", "0 is light, 1 is dark. Follows the system and data-theme."],
    ],
  },
  {
    group: "Color",
    items: [
      ["--lb-fill-light", "#ffffff", "Fill in the light theme."],
      ["--lb-fill-dark", "#3a3a3a", "Fill in the dark theme."],
      ["--lb-fill", "unset", "One fill for both themes. Overrides the two above."],
      ["--lb-text-light", "#000000", "Text in the light theme."],
      ["--lb-text-dark", "#ffffff", "Text in the dark theme."],
      ["--lb-text", "unset", "One text color for both themes."],
      ["--lb-tint", "#007aff", "Color of lb-tinted glass."],
      ["--lb-tint-text", "#ffffff", "Text on lb-tinted glass."],
      ["--lb-shade-color", "#000000", "The dark parts: volume shading, edge, drop shadow."],
      ["--lb-shine-color", "#ffffff", "The light parts: rims, glow, press highlight."],
    ],
  },
  {
    group: "Behavior",
    items: [
      ["--lb-highlight-size", "1", "Size of the press highlight, as a multiplier. It already scales with the element."],
      ["--lb-swell", "1.1", "Scale while pressed, at button size. Smaller glass grows more, larger less."],
      ["--lb-stretch", "2", "Stretch strength. 0 turns it off."],
      ["--lb-edge-size", "28px", "Length of the scroll edge fade (lb-edge, lb-edge-x)."],
      ["--lb-edge-start", "--lb-edge-size", "The same for the top or left. 0px turns that edge off."],
      ["--lb-edge-end", "--lb-edge-size", "The same for the bottom or right. 0px turns that edge off."],
      ["--lb-edge-strength", "1", "How transparent content gets at a scroll edge. 1 is fully."],
      ["--lb-stretch-axis", "both", "Stretch direction: x, y or both. Use x for a switch thumb that stays in its track."],
    ],
  },
];
---

<div class="vars">
  {
    vars.map((g) => (
      <>
        <div class="vars__group">{g.group}</div>
        {g.items.map(([name, value, what]) => (
          <div class="var">
            <code>{name}</code>
            <span class="var__default">
              {value.startsWith("#") && <span class="dot" style={`--c: ${value}`} />}
              <code>{value}</code>
            </span>
            <span class="var__what">{what}</span>
          </div>
        ))}
      </>
    ))
  }
</div>
