---
/** Every class, each on a piece of glass to press */
const classes = [
  {
    name: "lb",
    text: "The material. Backdrop blur, a fill, volume, rims, an edge and a shadow. Required.",
    sample: "lb",
    bd: "bd-aurora",
  },
  {
    name: "lb-clear",
    text: "Clearer glass, at least transparency 1. For use over photos and video.",
    sample: "lb lb-clear",
    bd: "bd-stripes",
  },
  {
    name: "lb-tinted",
    text: "Filled with --lb-tint, text in --lb-tint-text. Volume and rims stay.",
    sample: "lb lb-tinted",
    bd: "bd-aurora",
  },
  {
    name: "lb-lens",
    text: "Glass without blur, so what's underneath stays sharp. To turn a thumb into a lens while held, transition --lb-lens.",
    sample: "lb lb-lens",
    bd: "bd-stripes",
  },
  {
    name: "lb-highlight",
    text: "Lights up where it's pressed and follows the finger. Press it.",
    sample: "lb lb-highlight",
    bd: "bd-dots",
  },
  {
    name: "lb-swell",
    text: "Grows while pressed, on a spring that can reverse mid-way. Small glass grows more, large glass barely.",
    sample: "lb lb-swell lb-highlight",
    bd: "bd-aurora",
  },
  {
    name: "lb-stretch",
    text: "Pulls toward the finger and stretches along the drag. Small glass feels light, large glass heavy. Drag it.",
    sample: "lb lb-stretch lb-highlight",
    bd: "bd-stripes",
  },
  {
    name: "lb-interactive",
    text: "All three at once, the usual set for buttons, chips and icons. Press it, drag it.",
    sample: "lb lb-interactive",
    bd: "bd-aurora",
  },
];
---

<div class="rows">
  {
    classes.map((c) => (
      <div class="row">
        <div class="cell">
          <b>
            <code>{c.name}</code>
          </b>
          {c.text}
        </div>
        <div class="tile">
          <div class={`bd ${c.bd}`} />
          <button class={c.sample} type="button">
            {c.name}
          </button>
        </div>
      </div>
    ))
  }
</div>
