---
/**
 * A live example with its code behind tabs: the example in the default slot, the code in the
 * `html`, `js`, `react`, `vue` and `css` slots (Markdown code blocks). A tab shows only for a slot
 * that's filled. With a framework's code given, the HTML and TS tabs are for TypeScript without a framework and the
 * React and Vue tabs their own: each shows while the page shows its framework
 */
const react = Astro.slots.has("react");
const vue = Astro.slots.has("vue");
const tabs = (
  [
    ["example", "Example", undefined],
    ["html", "HTML", react || vue ? "js" : undefined],
    ["js", "TS", react || vue ? "js" : undefined],
    ["react", "React", "react"],
    ["vue", "Vue", "vue"],
    ["css", "CSS", undefined],
  ] as const
).filter(([slot]) => slot === "example" || Astro.slots.has(slot));
---

<div class="ex" data-ex>
  <div class="ex__bar">
    <div class="seg" role="group" aria-label="Show">
      <span class="seg__thumb" aria-hidden="true"></span>
      {
        tabs.map(([value, label, only], i) => (
          <button type="button" data-value={value} data-only={only} aria-pressed={i === 0 ? "true" : "false"}>
            {label}
          </button>
        ))
      }
    </div>
  </div>
  <div class="ex__panel" data-panel="example"><slot /></div>
  {Astro.slots.has("html") && <div class="ex__panel" data-panel="html" hidden><slot name="html" /></div>}
  {Astro.slots.has("js") && <div class="ex__panel" data-panel="js" hidden><slot name="js" /></div>}
  {react && <div class="ex__panel" data-panel="react" hidden><slot name="react" /></div>}
  {vue && <div class="ex__panel" data-panel="vue" hidden><slot name="vue" /></div>}
  {Astro.slots.has("css") && <div class="ex__panel" data-panel="css" hidden><slot name="css" /></div>}
</div>

<style>
  .ex { margin-block: 20px; }
  .ex:first-child { margin-top: 0; }
  .ex:last-child { margin-bottom: 0; }
  .ex__bar { margin-bottom: 10px; }
  .ex__panel > :global(.code) { margin: 0; }
  .ex__panel > :global(.code + .code) { margin-top: 10px; }
</style>

<script>
  import { segmented } from "../../scripts/segmented";

  for (const ex of document.querySelectorAll<HTMLElement>("[data-ex]:not([data-ex-ready])")) {
    ex.dataset.exReady = "";
    const panels = [...ex.querySelectorAll<HTMLElement>(":scope > [data-panel]")];
    const tabs = segmented(ex.querySelector<HTMLElement>(".seg")!, (value) => {
      for (const panel of panels) panel.hidden = panel.dataset.panel !== value;
    });
    // Another framework chosen: a tab of the one before is gone, so it's the example again
    window.addEventListener("fk:framework", () => {
      const open = ex.querySelector<HTMLElement>(`.seg button[data-value="${tabs.value()}"]`);
      if (open && !open.checkVisibility()) tabs.select("example");
    });
  }
</script>
