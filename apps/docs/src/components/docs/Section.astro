---
/**
 * A section of a package's page, under a heading of its own; the page's contents list these. With
 * `only`, it's written for one framework and shows only with that one chosen
 */
interface Props {
  id: string;
  title: string;
  only?: "js" | "react";
}

const { id, title, only } = Astro.props;
---

<section class="doc reveal" id={id} data-only={only}>
  <h2 class="doc__title">
    <a class="anchor" href={`#${id}`}>{title}</a>{only && <span class="doc__only">{only === "react" ? "React" : "JavaScript"}</span>}
  </h2>
  <slot />
</section>
