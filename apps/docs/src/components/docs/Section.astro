---
/**
 * A section of a package's page, under a heading of its own; the page's contents list these. With
 * `only`, it's written for some frameworks (`"js"`, `"react"`, `"vue"`, `"svelte"`, or several, `"vue svelte"`) and shows
 * only while the page shows one of them, its title saying which
 */
interface Props {
  id: string;
  title: string;
  only?: string;
}

const { id, title, only } = Astro.props;
const names: Record<string, string> = { js: "TypeScript", react: "React", vue: "Vue", svelte: "Svelte" };
---

<section class="doc reveal" id={id} data-only={only}>
  <h2 class="doc__title">
    <a class="anchor" href={`#${id}`}>{title}</a>{
      only?.split(" ").map((framework) => (
        <span class="doc__only" data-only={framework}>
          {names[framework]}
        </span>
      ))
    }
  </h2>
  <slot />
</section>
