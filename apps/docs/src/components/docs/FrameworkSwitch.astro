---
/**
 * Which framework the docs are written for: JavaScript or React. Remembered across pages, and in
 * three places on a page (under its opening, in the contents beside it, in the folded contents on a
 * phone), every one moving with the others. Switching keeps the place being read where it is
 */
interface Props {
  /** Where it is: under the opening, with a line on what React gets here; in the contents; folded */
  place?: "head" | "toc" | "fold";
  /** What React gets on this page; inline HTML */
  note?: string;
}

const { place = "head", note } = Astro.props;
---

<div class:list={["framework", `framework--${place}`]}>
  <span class="framework__label">{place === "toc" ? "Framework" : "Docs for"}</span>
  <div class="seg" role="group" aria-label="Framework" data-framework-switch>
    <span class="seg__thumb" aria-hidden="true"></span>
    <button type="button" data-value="js" aria-pressed="true">JavaScript</button>
    <button type="button" data-value="react" aria-pressed="false">React</button>
  </div>
  {note && <p class="framework__note" data-only="react" set:html={note} />}
</div>

<script>
  import { segmented } from "../../scripts/segmented";

  const root = document.documentElement;
  const controls = [...document.querySelectorAll<HTMLElement>("[data-framework-switch]")].map((seg) =>
    segmented(seg, (value) => choose(value)),
  );

  /**
   * What's read now, to keep in place: the first block written for both frameworks at or under the
   * top of the screen (below the nav), and how far down it is
   */
  const anchor = () => {
    const blocks = document.querySelectorAll<HTMLElement>(
      ".docs-head, .doc > .doc__title, .doc > :not(.only, .doc__title), .doc > .only > *",
    );
    for (const el of blocks) {
      if (el.closest("[data-only]") || !el.checkVisibility()) continue;
      const top = el.getBoundingClientRect().top;
      if (top >= 80) return { el, top };
    }
    return null;
  };

  function choose(framework: string) {
    if ((root.dataset.framework ?? "js") === framework) return;
    const kept = anchor();
    if (framework === "react") root.dataset.framework = "react";
    else delete root.dataset.framework;
    // The page above may have grown or shrunk: what was read is put back where it was
    if (kept) window.scrollBy({ top: kept.el.getBoundingClientRect().top - kept.top, behavior: "instant" });
    try {
      localStorage.setItem("fk-framework", framework);
    } catch {}
    for (const control of controls) control.select(framework, true);
    // A link to this page says it from now on, and the examples hear of it
    const url = new URL(location.href);
    if (url.searchParams.has("framework")) {
      url.searchParams.set("framework", framework);
      history.replaceState(history.state, "", url);
    }
    window.dispatchEvent(new CustomEvent("fk:framework", { detail: framework }));
  }

  const now = root.dataset.framework ?? "js";
  for (const control of controls) control.select(now, true);
</script>
