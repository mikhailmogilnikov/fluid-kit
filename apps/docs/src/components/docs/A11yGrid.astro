---
import Icon from "../Icon.astro";

/** Every system setting the material honors */
const a11y = [
  ["eye", "Reduced transparency", "With the system setting on, glass becomes opaque and the blur is removed."],
  ["contrast", "Increased contrast", "Opaque glass with a stronger edge, so every control keeps its outline."],
  ["frame", "Forced colors", "Windows High Contrast removes backgrounds and shadows; an outline replaces them, including around merged groups."],
  ["motion", "Reduced motion", "No swell or stretch, and morphs switch instantly. Presses still light up."],
  ["keyboard", "Keyboard", "Enter and Space press focused glass until the key is released."],
  ["layers", "Solid material", '<code>data-lb-material="solid"</code> on any ancestor makes all glass inside it opaque.'],
] as const;
---

<ul class="grid grid--doc">
  {
    a11y.map(([icon, title, text]) => (
      <li>
        <Icon name={icon} size={24} />
        <b>{title}</b>
        <p set:html={text} />
      </li>
    ))
  }
</ul>
