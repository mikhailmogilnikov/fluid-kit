{
  "name": "@fluidkit/drag",
  "version": "1.5.0",
  "description": "Drag one element with rubber-band edges and snap points, let go on a spring that keeps the finger's speed: sheets, swipe actions, switches.",
  "keywords": [
    "drag",
    "fluidkit",
    "gesture",
    "react",
    "rubber-band",
    "sheet",
    "snap",
    "spring",
    "svelte",
    "swipe",
    "vue"
  ],
  "homepage": "https://fluidkit.mogilnikov.dev/drag",
  "bugs": {
    "url": "https://github.com/mikhailmogilnikov/fluid-kit/issues"
  },
  "license": "MIT",
  "author": "Mikhail Mogilnikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikhailmogilnikov/fluid-kit.git",
    "directory": "packages/drag"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && fk-svelte-package -i src/svelte -o dist/svelte --tsconfig tsconfig.svelte.json",
    "dev": "vp pack --watch",
    "check-types": "tsc --noEmit && fk-svelte-check --tsconfig tsconfig.svelte.json",
    "test": "vp test run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@fluidkit/core": "workspace:^"
  },
  "devDependencies": {
    "@fluidkit/svelte-tools": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "^21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svelte": "5.57.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0",
    "vue": "3.5.44"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=5.29",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
