{
  "name": "@fluidkit/indicator",
  "version": "1.0.3",
  "description": "One element that flies onto whatever is hovered, pressed or chosen: menus, tabs, segmented controls. On interruptible springs, blurred by its own speed.",
  "keywords": [
    "fluidkit",
    "highlight",
    "indicator",
    "menu",
    "segmented-control",
    "spring",
    "tabs"
  ],
  "homepage": "https://fluidkit.mogilnikov.dev/indicator",
  "bugs": {
    "url": "https://github.com/mikhailmogilnikov/fluid-kit/issues"
  },
  "license": "MIT",
  "author": "Mikhail Mogilnikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikhailmogilnikov/fluid-kit.git",
    "directory": "packages/indicator"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@fluidkit/core": "workspace:^"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0"
  }
}
