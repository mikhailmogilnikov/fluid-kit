{
  "name": "@fluidkit/blur",
  "version": "1.6.1",
  "description": "A glass material for the web: backdrop blur, fill, rims, springy press behaviors and glass that melts between shapes. No refraction.",
  "keywords": [
    "backdrop-filter",
    "blur",
    "css",
    "fluidkit",
    "glass",
    "liquid-glass",
    "material",
    "react",
    "svelte",
    "vue"
  ],
  "homepage": "https://fluidkit.mogilnikov.dev/blur",
  "bugs": {
    "url": "https://github.com/mikhailmogilnikov/fluid-kit/issues"
  },
  "license": "MIT",
  "author": "Mikhail Mogilnikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikhailmogilnikov/fluid-kit.git",
    "directory": "packages/blur"
  },
  "files": [
    "dist",
    "!dist/styles.js",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/auto.js"
  ],
  "exports": {
    "./style.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/style.css"
    },
    "./press": {
      "types": "./dist/press.d.ts",
      "default": "./dist/press.js"
    },
    "./melt": {
      "types": "./dist/melt.d.ts",
      "default": "./dist/melt.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack && fk-svelte-package -i src/svelte -o dist/svelte --tsconfig tsconfig.svelte.json",
    "dev": "vp pack --watch",
    "check-types": "tsc --noEmit && fk-svelte-check --tsconfig tsconfig.svelte.json",
    "test": "vp test run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@fluidkit/core": "workspace:^"
  },
  "devDependencies": {
    "@fluidkit/svelte-tools": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "^21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svelte": "5.57.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0",
    "vue": "3.5.44"
  },
  "peerDependencies": {
    "react": ">=18",
    "svelte": ">=5.29",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
