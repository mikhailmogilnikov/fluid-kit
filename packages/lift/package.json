{
  "name": "@fluidkit/lift",
  "version": "1.0.0",
  "description": "A long press lifts any element above everything, the page dimmed and blurred behind it, and opens your menu beside it: iOS's context menu, for the web.",
  "keywords": [
    "context-menu",
    "fluidkit",
    "lift",
    "long-press",
    "menu",
    "peek",
    "preview",
    "spring"
  ],
  "homepage": "https://fluidkit.mogilnikov.dev/lift",
  "bugs": {
    "url": "https://github.com/mikhailmogilnikov/fluid-kit/issues"
  },
  "license": "MIT",
  "author": "Mikhail Mogilnikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikhailmogilnikov/fluid-kit.git",
    "directory": "packages/lift"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@fluidkit/core": "workspace:^"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0"
  }
}
