{
  "name": "@fluidkit/lift",
  "version": "1.2.0",
  "description": "A long press lifts any element above everything, the page dimmed and blurred behind it, and opens your menu beside it: iOS's context menu, for the web.",
  "keywords": [
    "context-menu",
    "fluidkit",
    "lift",
    "long-press",
    "menu",
    "peek",
    "preview",
    "react",
    "spring"
  ],
  "homepage": "https://fluidkit.mogilnikov.dev/lift",
  "bugs": {
    "url": "https://github.com/mikhailmogilnikov/fluid-kit/issues"
  },
  "license": "MIT",
  "author": "Mikhail Mogilnikov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikhailmogilnikov/fluid-kit.git",
    "directory": "packages/lift"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "default": "./dist/vue.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "check-types": "tsc --noEmit",
    "test": "vp test run",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check-types && pnpm test"
  },
  "dependencies": {
    "@fluidkit/core": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "^21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0",
    "vue": "3.5.44"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
